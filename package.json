{
  "name": "spotibuds-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:legacy": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src tests scripts package.json package-lock.json tsconfig.json *.ts *.mts *.mjs .github",
    "format:check": "prettier --check src tests scripts package.json package-lock.json tsconfig.json *.ts *.mts *.mjs .github",
    "test": "vitest run",
    "test:browser": "playwright test",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.1.1",
    "@microsoft/signalr": "8.0.17",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sweetalert2-react-content": "^5.1.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.19.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "29.0.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": ">=11 <12"
  },
  "overrides": {}
}
