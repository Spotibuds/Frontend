      "kind": "input",
      "refersTo": "input",
      "description": "Shared labeled field; invalid state supports a linked error message.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-playlist-name\">Playlist name</label><input class=\"ds-input\" id=\"ds-playlist-name\" type=\"text\" placeholder=\"Playlist name\" aria-invalid=\"false\"></div>",
      "css": ".ds-field{display:grid;gap:4px}.ds-field-label{font-family:var(--font-sans,\"Segoe UI\",sans-serif);font-size:14px;line-height:20px;font-weight:500;color:var(--color-gray-300,#cecfd4)}.ds-input{box-sizing:border-box;width:100%;height:44px;padding:8px 12px;border:1px solid var(--color-gray-600,#4c4f58);border-radius:8px;background:var(--background,#121315);color:var(--foreground,#f2f0ed);font-family:var(--font-sans,\"Segoe UI\",sans-serif);font-size:14px;line-height:20px;caret-color:var(--primary,#b5a0eb);transition:border-color 150ms cubic-bezier(.4,0,.2,1)}.ds-input::placeholder{color:var(--muted-foreground,#afb1b9)}.ds-input:hover{border-color:var(--color-gray-500,#979aa5)}.ds-input:focus-visible{outline:2px solid var(--ring,#b5a0eb);outline-offset:3px;box-shadow:0 0 0 2px #121315,0 0 0 4px oklch(62.7% .265 303.9)}.ds-input[aria-invalid=true]{border-color:var(--color-red-500,oklch(63.7% .237 25.331))}.ds-input[aria-invalid=true]:focus-visible{box-shadow:0 0 0 2px #121315,0 0 0 4px oklch(63.7% .237 25.331)}@media(prefers-reduced-motion:reduce){.ds-input{transition-duration:.01ms}}"
